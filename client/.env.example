# Project Eklavya — Frontend Vercel Environment Variables
# Replace with your deployed Render backend app URL in production

# Full URL prefix to the backend REST API
VITE_API_BASE_URL=https://project-eklavya.onrender.com/api

# Root URL origin of the backend server (used to resolve static audio uploads)
VITE_API_ROOT_URL=https://project-eklavya.onrender.com
