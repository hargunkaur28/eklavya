PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/project_eklavya
JWT_SECRET=replace_with_a_long_random_secret
GROQ_API_KEY=gsk_demo_key
SARVAM_API_KEY=sarvam_demo_key
YOUTUBE_API_KEY=
FRONTEND_URL=https://project-eklavya.vercel.app

# Admin panel (optional). Setting ADMIN_EMAIL enables /api/admin/* — if set, the
# server refuses to boot unless ADMIN_PASSWORD and ADMIN_SECURITY_CODE are also set.
# Change any of the three and restart to update the admin credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SECURITY_CODE=

# Cloudinary — profile photo uploads. The server uploads with these credentials;
# they are NEVER exposed to the client. Get them from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Hindi TTS fallback when Sarvam Bulbul is unavailable/out-of-quota (Groq TTS cannot do
# Hindi). Optional but strongly recommended — without it Hindi narration degrades to
# browser Web Speech. Model: gpt-4o-mini-tts.
OPENAI_API_KEY=

# Brevo (formerly Sendinblue) Transactional Email API for failed-login security alerts & OTPs
BREVO_API_KEY=
MAIL_FROM_EMAIL=noreply@eklavya.test
MAIL_FROM_NAME=Project Eklavya
