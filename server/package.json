    "test:coverage": "node test-coverage-handoff.mjs",
    "test:filler": "node test-filler-audit.mjs",
    "test:graft": "node test-graft-budget.mjs",
    "test:notes": "node test-mynotes.mjs",
    "test:reorder": "node test-reorder.mjs",
    "test:privacy": "node test-aadhaar-privacy.mjs",
    "diag:cloudinary": "node test-cloudinary-keys.mjs",
    "test:server": "npm run test:invariants && npm run test:diagnostic && npm run test:coverage && npm run test:graft && npm run test:notes && npm run test:reorder && node test-lowergrade-figures.mjs && node test-auth-payload-shape.mjs && node test-aadhaar-key-absence.mjs",
    "test:diagrams": "node test-diagram-wiring.mjs",
    "test:lowergrade": "node test-lowergrade-figures.mjs",
    "test:hindi": "node test-hindi-register.mjs",
    "test:glossary": "node test-hindi-glossary.mjs",
