    "test:authshape": "node test-auth-payload-shape.mjs",
    "test:aadhaar-absence": "node test-aadhaar-key-absence.mjs",
    "test:nucleus": "node test-nucleus-figure.mjs",
    "test:svgsize": "node test-diagram-size-baseline.mjs",
